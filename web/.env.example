# Copy to web/.env and fill in. web/.env is gitignored.

# Google Maps JavaScript API key — used by the "Find any address" search and
# the map. This is baked into the client bundle at build time, so the key MUST
# have an HTTP-referrer restriction for your deployed domain (and localhost for
# dev). Enable: Maps JavaScript API, Places API, Places API (New).
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# SeeNoise Worker API base URL.
#  - Leave EMPTY for production: the Worker serves this app from the same origin.
#  - For local dev, run `npm run dev:worker` (wrangler dev, :8787) and set:
#    REACT_APP_NOISE_API_BASE=http://localhost:8787
REACT_APP_NOISE_API_BASE=

# Development settings
REACT_APP_ENVIRONMENT=development
